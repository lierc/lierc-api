#!/usr/bin/env perl

# Deletes users and all their data, given user ids as arguments or one per
# line on stdin. Without --delete it's a dry run: it prints what each user
# has and changes nothing.
#
#   bin/delete-users ID...             # dry run
#   bin/delete-users --delete ID...    # delete
#   cut -f1 ids.txt | bin/delete-users --delete
#
# Run where the API runs (it reads the same environment: POSTGRES_*,
# LIERCD_HOST), e.g. docker exec into the lierc-api container and run
# perl -Ilocal/lib/perl5 -Ilib bin/delete-users ...
#
# Every listed user's IRC connections are destroyed in liercd first, so they
# stop running. If liercd can't be reached or refuses (anything but 200, or
# 404 for a connection that isn't running), that user is skipped and nothing
# of theirs is deleted. Destroying a connection makes it QUIT, and that
# message reaches the log through NSQ and the logger a moment later, so the
# script waits (--settle SECONDS, default 5) before deleting. Each user's rows
# are then deleted in one transaction: a user is either fully deleted or left
# as they were. A last sweep removes any log rows that still arrived late.

use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use API;
use API::Config;

my $delete = 0;
my $settle = 5;
my @ids;
while (defined(my $arg = shift @ARGV)) {
  if ($arg eq "--delete") { $delete = 1 }
  elsif ($arg eq "--settle") {
    $settle = shift @ARGV;
    die "--settle needs a number of seconds\n" unless defined $settle && $settle =~ /^\d+$/;
  }
  elsif ($arg =~ /^-/) { die "unknown option $arg\n" }
  else { push @ids, $arg }
}
if (!@ids && !-t STDIN) {
  while (my $line = <STDIN>) {
    $line =~ s/^\s+|\s+$//g;
    push @ids, $line if length $line;
  }
}
die "usage: $0 [--delete] USER_ID...  (or user ids on stdin)\n" unless @ids;

my $api = API->new(API::Config->new->as_hash);
my $dbh = $api->dbh;

# what each table holds for a user; "conns" is the user's connection ids
my @tables = (
  [ log      => q{"user" = ? OR connection = ANY(?)}, "user_conns" ],
  [ seen     => q{"user" = ? OR connection = ANY(?)}, "user_conns" ],
  [ private  => q{connection = ANY(?)},               "conns" ],
  [ pref     => q{"user" = ?},                        "user" ],
  [ web_push => q{"user" = ?},                        "user" ],
  [ connection => q{"user" = ?},                      "user" ],
  [ '"user"' => q{id = ?},                            "user" ],
);

sub binds {
  my ($kind, $id, $conns) = @_;
  return ($id, $conns) if $kind eq "user_conns";
  return ($conns)      if $kind eq "conns";
  return ($id);
}

my ($done, $skipped) = (0, 0);
my @found;   # [user row, connection ids] for users that exist

for my $id (@ids) {
  my $user = $dbh->selectrow_hashref(
    q{SELECT id, username, email FROM "user" WHERE id = ?}, {}, $id
  );
  if (!$user) {
    print "$id: no such user, skipped\n";
    $skipped++;
    next;
  }

  my $conns = $dbh->selectcol_arrayref(
    q{SELECT id FROM connection WHERE "user" = ?}, {}, $id
  );

  my @counts = map {
    my ($table, $where, $kind) = @$_;
    my ($n) = $dbh->selectrow_array(
      "SELECT count(*) FROM $table WHERE $where", {}, binds($kind, $id, $conns)
    );
    (my $name = $table) =~ tr/"//d;
    "$name=$n";
  } @tables;

  print "$id ($user->{username}, $user->{email}): @counts\n";
  push @found, [$user, $conns];
}

if (!$delete) {
  print "dry run: nothing deleted; run with --delete to delete\n";
  exit;
}

# stop every connection first, so nothing keeps running for these users
my @ready;
for (@found) {
  my ($user, $conns) = @$_;
  my $ok = 1;
  for my $conn (@$conns) {
    my $res = $api->request(POST => "$conn/destroy");
    next if $res->code == 200 || $res->code == 404;
    print "$user->{id}: connection $conn: liercd said ", $res->status_line, ", skipping this user\n";
    $ok = 0;
    last;
  }
  if ($ok) { push @ready, $_ } else { $skipped++ }
}

# let the connections' QUIT messages reach the log before deleting it
sleep $settle if @ready && grep { @{ $_->[1] } } @ready;

my @deleted;
for (@ready) {
  my ($user, $conns) = @$_;
  my $id = $user->{id};
  $dbh->begin_work;
  my $ok = eval {
    for (@tables) {
      my ($table, $where, $kind) = @$_;
      $dbh->do("DELETE FROM $table WHERE $where", {}, binds($kind, $id, $conns));
    }
    $dbh->commit;
    1;
  };
  if ($ok) {
    print "$id: deleted\n";
    push @deleted, $_;
    $done++;
  }
  else {
    my $err = $@;
    $dbh->rollback;
    print "$id: failed, nothing deleted: $err";
    $skipped++;
  }
}

# anything the logger still wrote after the deletes
for (@deleted) {
  my ($user, $conns) = @$_;
  my $late = $dbh->do(
    q{DELETE FROM log WHERE "user" = ? OR connection = ANY(?)}, {}, $user->{id}, $conns
  );
  print "$user->{id}: removed $late late log row(s)\n" if $late > 0;
}

print "deleted $done user(s), skipped $skipped\n";
