#!/usr/bin/env perl

# Checks saved IRC connections against the rules the API applies when a
# connection is created or edited (API::ConnectionConfig: field formats, and
# hosts that resolve to loopback or private addresses), and prints each
# invalid one with the reason. Checks every connection, or only the
# connection ids given as arguments or one per line on stdin. Without
# --delete it's a dry run and changes nothing.
#
#   bin/check-connections                       # dry run, every connection
#   bin/check-connections ID...                 # dry run, these connections
#   bin/check-connections --delete ID...        # delete those found invalid
#   bin/check-connections --no-dns              # field formats only
#
# Run where the API runs (it reads the same environment: POSTGRES_*,
# LIERCD_HOST, DEFAULT_NETWORK_HOST/PORT, and the host's /etc/hosts), e.g.
# docker exec into the lierc-api container and run
# perl -Ilocal/lib/perl5 -Ilib bin/check-connections ...
#
# A host that doesn't resolve ("Couldn't find host") may be a passing DNS
# failure, so it's reported but not deleted unless --delete-unresolved is
# also given. Valid connections are never deleted.
#
# Deleting a connection destroys it in liercd first, so it stops running. If
# liercd can't be reached or refuses (anything but 200, or 404 for a
# connection that isn't running), that connection is skipped. Destroying
# makes it QUIT, and that message reaches the log through NSQ a moment
# later, so the script waits (--settle SECONDS, default 5), then deletes
# each connection's log, seen, private and connection rows in one
# transaction, and finally sweeps log rows that arrived late.

use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use API;
use API::Config;
use API::ConnectionConfig;
use JSON::XS;

my ($delete, $unresolved, $dns, $settle) = (0, 0, 1, 5);
my @ids;
while (defined(my $arg = shift @ARGV)) {
  if    ($arg eq "--delete")            { $delete = 1 }
  elsif ($arg eq "--delete-unresolved") { $unresolved = 1 }
  elsif ($arg eq "--no-dns")            { $dns = 0 }
  elsif ($arg eq "--settle") {
    $settle = shift @ARGV;
    die "--settle needs a number of seconds\n" unless defined $settle && $settle =~ /^\d+$/;
  }
  elsif ($arg =~ /^-/) { die "unknown option $arg\n" }
  else { push @ids, $arg }
}
if (!@ids && !-t STDIN) {
  while (my $line = <STDIN>) {
    $line =~ s/^\s+|\s+$//g;
    push @ids, $line if length $line;
  }
}
die "--delete-unresolved needs --delete\n" if $unresolved && !$delete;
die "--delete with --no-dns would skip the address check; pass connection ids or drop --no-dns\n"
  if $delete && !$dns && !@ids;

my $api = API->new(API::Config->new->as_hash);
my $dbh = $api->dbh;

my $rows = @ids
  ? $dbh->selectall_arrayref(
      q{SELECT c.id, c."user", c.config, u.username FROM connection c
        LEFT JOIN "user" u ON u.id = c."user" WHERE c.id = ANY(?) ORDER BY c.id},
      { Slice => {} }, \@ids)
  : $dbh->selectall_arrayref(
      q{SELECT c.id, c."user", c.config, u.username FROM connection c
        LEFT JOIN "user" u ON u.id = c."user" ORDER BY c.id},
      { Slice => {} });

my %found = map { $_->{id} => 1 } @$rows;
print "$_: no such connection\n" for grep { !$found{$_} } @ids;

# The reason a saved config is invalid, or undef if it's valid.
sub problem {
  my $json = shift;
  my $params = eval { decode_json $json };
  return "config isn't a JSON object\n" unless ref $params eq "HASH";
  my $config = eval { API::ConnectionConfig->clean($params) } or return $@;
  return undef unless $dns;
  eval { API::ConnectionConfig->check_host($config->{Host}, $config->{Port}); 1 } or return $@;
  return undef;
}

my ($valid, @invalid) = (0);
for my $row (@$rows) {
  my $why = problem($row->{config});
  if (!defined $why) { $valid++; next }
  chomp $why;
  my $params = eval { decode_json $row->{config} } || {};
  my $where = ref $params eq "HASH"
    ? join(":", map { defined && !ref ? $_ : "?" } $params->{Host}, $params->{Port})
    : "?";
  $row->{unresolved} = $why =~ /^Couldn't find host/;
  printf "%s (user %s, %s, %s): %s\n", $row->{id}, $row->{user},
    $row->{username} // "no such user", $where, $why;
  push @invalid, $row;
}
printf "%d connection(s) checked: %d valid, %d invalid%s\n",
  scalar @$rows, $valid, scalar @invalid, $dns ? "" : " (field formats only, no DNS)";

if (!$delete) {
  print "dry run: nothing deleted; run with --delete to delete the invalid ones\n" if @invalid;
  exit;
}

my @targets = grep { $unresolved || !$_->{unresolved} } @invalid;
my $kept = @invalid - @targets;
print "$kept unresolved host(s) kept; add --delete-unresolved to delete them\n" if $kept;
exit unless @targets;

# stop each connection first, so nothing keeps running or logging
my (@ready, $skipped);
for my $row (@targets) {
  my $res = $api->request(POST => "$row->{id}/destroy");
  if ($res->code == 200 || $res->code == 404) { push @ready, $row; next }
  print "$row->{id}: liercd said ", $res->status_line, ", skipped\n";
  $skipped++;
}

# let the QUIT messages reach the log before deleting it
sleep $settle if @ready;

my @tables = qw(log seen private connection);
my @deleted;
for my $row (@ready) {
  my $id = $row->{id};
  $dbh->begin_work;
  my %n;
  my $ok = eval {
    for my $table (@tables) {
      my $col = $table eq "connection" ? "id" : "connection";
      $n{$table} = $dbh->do("DELETE FROM $table WHERE $col = ?", {}, $id) + 0;
    }
    $dbh->commit;
    1;
  };
  if ($ok) {
    print "$id: deleted (", join(" ", map { "$_=$n{$_}" } @tables), ")\n";
    push @deleted, $id;
  }
  else {
    my $err = $@;
    $dbh->rollback;
    print "$id: failed, nothing deleted: $err";
    $skipped++;
  }
}

# anything the logger still wrote after the deletes
if (@deleted) {
  my $late = $dbh->do(q{DELETE FROM log WHERE connection = ANY(?)}, {}, \@deleted);
  print "removed $late late log row(s)\n" if $late > 0;
}

printf "deleted %d connection(s), skipped %d\n", scalar @deleted, $skipped // 0;
